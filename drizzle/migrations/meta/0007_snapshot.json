        "agenda_entries_title_check": {
          "name": "agenda_entries_title_check",
          "value": "length(trim(\"agenda_entries\".\"title\")) between 1 and 160"
        },
        "agenda_entries_notes_check": {
          "name": "agenda_entries_notes_check",
          "value": "length(\"agenda_entries\".\"notes\") <= 2000"
        },
        "agenda_entries_tags_check": {
          "name": "agenda_entries_tags_check",
          "value": "\"agenda_entries\".\"tags\" <@ ARRAY['trabalho','casal','pessoal']::text[] AND cardinality(\"agenda_entries\".\"tags\") between 1 and 3 AND array_position(\"agenda_entries\".\"tags\", NULL) IS NULL"
        },
        "agenda_entries_period_check": {
          "name": "agenda_entries_period_check",
          "value": "\"agenda_entries\".\"period\" in ('anytime','morning','afternoon','evening')"
        },
        "agenda_entries_time_check": {
          "name": "agenda_entries_time_check",
          "value": "(\"agenda_entries\".\"start_time\" IS NULL OR \"agenda_entries\".\"start_time\" ~ '^([01][0-9]|2[0-3]):[0-5][0-9]$') AND (\"agenda_entries\".\"end_time\" IS NULL OR (\"agenda_entries\".\"start_time\" IS NOT NULL AND \"agenda_entries\".\"end_time\" ~ '^([01][0-9]|2[0-3]):[0-5][0-9]$' AND \"agenda_entries\".\"end_time\" > \"agenda_entries\".\"start_time\"))"
        }
      },
      "isRLSEnabled": false
    },
